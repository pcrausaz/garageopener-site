---
import { FAQ } from "../i18n/faq";
import type { Locale } from "../i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<div>
  {FAQ[locale].map(({ q, a }) => (
    <details class="faq-item">
      <summary><span>{q}</span></summary>
      <div set:html={a} />
    </details>
  ))}
</div>
